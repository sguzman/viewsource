{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Viewsource public technology inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "specimen_id",
    "version",
    "capture_scope",
    "method",
    "privacy",
    "technologies",
    "unresolved",
    "page_map"
  ],
  "properties": {
    "format_version": {
      "const": 1
    },
    "specimen_id": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "capture_scope": {
      "enum": [
        "saved_page",
        "saved_archive"
      ]
    },
    "method": {
      "type": "string"
    },
    "privacy": {
      "type": "string"
    },
    "technologies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "component_ref",
          "category",
          "confidence",
          "evidence",
          "observations",
          "role",
          "version",
          "note"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "component_ref": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "confidence": {
            "enum": [
              "strong",
              "likely",
              "indicator"
            ]
          },
          "evidence": {
            "type": "string"
          },
          "observations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "marker",
                "matches",
                "files"
              ],
              "properties": {
                "marker": {
                  "type": "string"
                },
                "matches": {
                  "type": "integer",
                  "minimum": 1
                },
                "files": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "role": {
            "type": "string"
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "technology",
          "reason"
        ],
        "properties": {
          "technology": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "page_map": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "nodes",
        "observed_control_categories",
        "note"
      ],
      "properties": {
        "method": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "title",
              "kind",
              "description",
              "counts",
              "evidence"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "parent": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "counts": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "evidence": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "observed_control_categories": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label",
              "aria_matches"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "aria_matches": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  }
}
